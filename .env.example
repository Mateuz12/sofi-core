# ============================================================
# SOFI — Sistema Operacional Financeiro Integrado
# .env central — NÃO SUBIR PARA O GITHUB
# ============================================================

# ── RETAGUARDA (login único para todas as unidades) ─────────
RETAGUARDA_URL=https://cp10488.retaguarda.grupoboticario.com.br/
RETAGUARDA_USER=
RETAGUARDA_PASS=

# ── FINANÇAS GB — UDI ───────────────────────────────────────
FINANCAS_URL=https://financasgb.grupoboticario.com.br/
FINANCAS_UDI_USER=
FINANCAS_UDI_PASS=

# ── FINANÇAS GB — BH ────────────────────────────────────────
FINANCAS_BH_USER=
FINANCAS_BH_PASS=

# ── EXTRANET ────────────────────────────────────────────────
EXTRANET_URL=https://extranet.grupoboticario.com.br/
EXTRANET_USER=
EXTRANET_PASSWORD=

# ── CONFIGURAÇÕES DE BROWSER ────────────────────────────────
HEADLESS=false
BROWSER_CHANNEL=chrome
DISABLE_HTTP2=true

# ── XML / NOTAS FISCAIS ─────────────────────────────────────
CERT_PASSWORD=
MEUDANFE_API_KEY=

# ── DEPÓSITOS ───────────────────────────────────────────────
DEPOSITOS_API_URL=https://financasgb.grupoboticario.com.br/FechamentoDeCaixaAPI/RealizarDeposito/

# ── CAMINHOS DE ARQUIVO ─────────────────────────────────────
ORACLE_PATH=
LOCAL_OUTPUT_PATH=
LOG_DB_PATH=database/sofi.db

# ── CONFIGURAÇÕES GERAIS ────────────────────────────────────
EMPRESA=
AMBIENTE=development
