# Credenciais de acesso ao portal Grupo Boticário
USUARIO=seu_usuario_aqui
SENHA=sua_senha_aqui

# false = navegador visivel para debug; true = rodar em segundo plano
HEADLESS=false

# Pausa antes de clicar em Entrar, em segundos
DELAY_ANTES_LOGIN_SEGUNDOS=3

# Use chrome como no extranet_reports; deixe vazio para Chromium do Playwright
BROWSER_CHANNEL=chrome

# true ajuda em erros de callback como ERR_HTTP2_PROTOCOL_ERROR
DESABILITAR_HTTP2=true

# Tamanho da janela do navegador
VIEWPORT_LARGURA=1366
VIEWPORT_ALTURA=768
